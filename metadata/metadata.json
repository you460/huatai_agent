  "business_metrics": [
    {
      "metric_name": "客户总资产",
      "metric_formula": "coalesce(nm_tot_aset, 0) + coalesce(fc_pur_aset, 0)",
      "metric_desc": "客户全部账户的总资产合计，等于普通账户总资产加信用账户净资产",
      "related_tables": [
        "dws_cust_aset_d"
      ]
    },
    {
      "metric_name": "客户总交易金额",
      "metric_formula": "coalesce(buy_amt, 0) + coalesce(sell_amt, 0)",
      "metric_desc": "客户买入金额加卖出金额的合计，代表总交易规模",
      "related_tables": [
        "dwd_cust_tran_d"
      ]
    },
    {
      "metric_name": "客户总资金流入",
      "metric_formula": "coalesce(cash_in, 0) + coalesce(tran_in, 0) + coalesce(assign_in, 0)",
      "metric_desc": "客户所有资金与证券转入的合计",
      "related_tables": [
        "dws_cust_fin_d"
      ]
    },
    {
      "metric_name": "客户总资金流出",
      "metric_formula": "coalesce(cash_out, 0) + coalesce(tran_out, 0) + coalesce(assign_out, 0)",
      "metric_desc": "客户所有资金与证券转出的合计",
      "related_tables": [
        "dws_cust_fin_d"
      ]
    }
  ]
